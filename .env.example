# Kunci tunggal untuk seluruh endpoint /api/v1/*
API_KEY=ganti-dengan-kunci-random-yang-panjang

# Dashboard hanya dapat diakses dengan HTTP Basic Auth
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti-password-dashboard

APP_ADDR=:8080
MYSQL_DSN=root:@tcp(127.0.0.1:3306)/whatsapp_gateway?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

# Penyimpanan sesi terenkripsi WhatsApp. Library upstream hanya mendukung
# SQLite/PostgreSQL untuk session store; data aplikasi tetap di MySQL/MariaDB.
WHATSAPP_SESSION_DSN=file:data/whatsapp.db?_foreign_keys=on

# Opsional: rahasia untuk signature X-Webhook-Signature (HMAC SHA-256).
# Jika kosong, API_KEY digunakan.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=8
LOG_LEVEL=INFO

